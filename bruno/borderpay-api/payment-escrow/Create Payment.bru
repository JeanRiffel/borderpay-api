meta {
  name: Create Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/payment-escrow/create
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "paymentId": "0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcd",
    "beneficiary": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
    "sender": "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
  }
}

docs {
  Create a new escrow payment.

  - `paymentId`: bytes32 hex string, unique id for the payment.
  - `beneficiary`: address that will receive the funds once released.
  - `sender`: address that will fund the payment.
}
